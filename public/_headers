# Cloudflare Pages headers file: https://developers.cloudflare.com/pages/configuration/headers/
#
# style-src needs 'unsafe-inline': every view renders inline style="..."
# attributes (no CSS-in-JS build step), so a strict style-src would break
# the entire UI. script-src stays strict — no inline <script> or event
# handlers anywhere in the app (see js/components/states.js for the one
# case that used to exist and was switched to addEventListener for this).
# connect-src is the directive that actually matters here: it's what stops
# an XSS bug from ever being able to exfiltrate the student's token or
# grades to anywhere but beste.schule — and now api.pirsch.io, which is the
# cost of having analytics at all. Pirsch only ever receives the page view,
# never anything the app fetched; nothing widens that but this one host.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://api.pirsch.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self' https://beste.schule https://api.pirsch.io; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=()
